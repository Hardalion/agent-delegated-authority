# Placeholders only. Do not put real secrets in this file.
# Local mode generates ADAP_TEAM_TOKEN and ADAP_APPROVER_PASSPHRASE when they are unset.

ADAP_DEPLOYMENT=local
ADAP_TEAM_ID=local
ADAP_BIND_HOST=127.0.0.1
ADAP_DEMO_PORT=4317
ADAP_TEAM_TOKEN=
ADAP_APPROVER_PASSPHRASE=
ADAP_SESSION_SECRET=
ADAP_SANDBOX_URL=http://127.0.0.1:4318
ADAP_SANDBOX_TOKEN=
SANDBOX_PORT=4318
SANDBOX_DB=.demo/hackathon-sandbox.sqlite
SANDBOX_FAULTS=0
# Hosted mode also requires ADAP_COOKIE_SECURE=1 and a reverse proxy on 127.0.0.1.
# Never set these to treasury-demo.
