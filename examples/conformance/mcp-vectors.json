      },
      "expect": { "action": "BLOCK", "ruleId": "narrowing", "executorCalled": false, "receiptExecuted": false }
    },
    {
      "id": "mcp-auth-require-human",
      "claim": "authority-enforcing",
      "input": {
        "policyAction": "REQUIRE_HUMAN",
