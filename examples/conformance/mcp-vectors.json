      "expect": { "action": "BLOCK", "executorCalled": false }
    },
    {
      "id": "mcp-pol-allow",
      "claim": "policy-only",
      "input": {
        "policy": "basic-agent-authority",
        "toolName": "read",
        "toolArgs": {},
        "agentRole": "agt_reader"
      },
      "expect": { "action": "ALLOW", "executorCalled": true }
    },
    {
      "id": "mcp-auth-over-delegation",
      "claim": "authority-enforcing",
