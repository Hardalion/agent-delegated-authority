{
  "version": "0.1.0",
  "description": "Language-independent ADAP MCP conformance vectors (no side effects).",
  "vectors": [
    {
      "id": "mcp-pol-block",
      "claim": "policy-only",
      "input": {
        "policy": "basic-agent-authority",
        "toolName": "apply",
        "toolArgs": { "amount": 800 },
        "agentRole": "agt_reader"
      },
      "expect": { "action": "BLOCK", "executorCalled": false }
    },
    {
      "id": "mcp-pol-allow",
      "claim": "policy-only",
      "input": {
        "policy": "basic-agent-authority",
        "toolName": "read",
        "toolArgs": {},
        "agentRole": "agt_reader"
      },
      "expect": { "action": "ALLOW", "executorCalled": true }
    },
    {
      "id": "mcp-auth-over-delegation",
      "claim": "authority-enforcing",
      "input": {
        "parentMaxAmount": 500,
        "childMaxAmount": 800,
        "tool_definition_hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect": { "action": "BLOCK", "ruleId": "narrowing", "executorCalled": false, "receiptExecuted": false }
    },
    {
      "id": "mcp-auth-require-human",
      "claim": "authority-enforcing",
      "input": {
        "policyAction": "REQUIRE_HUMAN",
        "approval": null,
        "tool_definition_hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect": { "action": "REQUIRE_HUMAN", "executorCalled": false, "pendingBoundToIntentHash": true }
    },
    {
      "id": "mcp-auth-tool-def-drift",
      "claim": "authority-enforcing",
      "input": {
        "pinnedHash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "presentedHash": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      },
      "expect": { "action": "BLOCK", "executorCalled": false }
    },
    {
      "id": "mcp-receipt-tool-def-binding",
      "claim": "authority-enforcing",
      "input": {
        "toolDefinition": {
          "tool_name": "pay",
          "server_id": "treasury",
          "description": "Send a payment in EUR (€)",
          "input_schema": {
            "required": ["amount"],
            "type": "object",
            "properties": { "amount": { "type": "integer", "minimum": 1 } }
          },
          "annotations": { "destructiveHint": true, "title": "Pay" }
        }
      },
      "expect": {
        "toolDefinitionHash": "sha256:6ab05dee283ccf69ccb095d994be13457447dffa55538a58f3334d124e2e3450",
        "adapAction": "treasury.pay",
        "adapTarget": "mcp/treasury/pay",
        "receiptField": "execution.toolDefinitionHash"
      }
    }
  ]
}
