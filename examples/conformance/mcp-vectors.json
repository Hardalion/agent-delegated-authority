        "tool_definition_hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect": { "action": "REQUIRE_HUMAN", "executorCalled": false, "pendingBoundToIntentHash": true }
    },
    {
      "id": "mcp-auth-tool-def-drift",
      "claim": "authority-enforcing",
      "input": {
        "pinnedHash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "presentedHash": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      },
      "expect": { "action": "BLOCK", "executorCalled": false }
    }
  ]
