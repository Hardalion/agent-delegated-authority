{
  "version": "0.1.0",
  "description": "Language-independent ADAP MCP conformance vectors (no side effects).",
  "vectors": [
    {
      "id": "mcp-pol-block",
      "claim": "policy-only",
      "input": {
        "policy": "basic-agent-authority",
        "toolName": "apply",
        "toolArgs": { "amount": 800 },
        "agentRole": "agt_reader"
      },
      "expect": {
        "action": "BLOCK",
        "executorCalled": false
      }
    },
    {
      "id": "mcp-pol-allow",
      "claim": "policy-only",
      "input": {
        "policy": "basic-agent-authority",
        "toolName": "read",
        "toolArgs": {},
        "agentRole": "agt_reader"
      },
      "expect": {
        "action": "ALLOW",
        "executorCalled": true
      }
    },
    {
      "id": "mcp-auth-over-delegation",
      "claim": "authority-enforcing",
      "setup": "child max_amount greater than parent",
      "expect": {
        "action": "BLOCK",
        "ruleId": "narrowing",
        "executorCalled": false,
        "receiptExecuted": false
      }
    },
    {
      "id": "mcp-auth-require-human",
      "claim": "authority-enforcing",
      "setup": "intent under grant; policy REQUIRE_HUMAN; no approval",
      "expect": {
        "action": "REQUIRE_HUMAN",
        "executorCalled": false,
        "pendingBoundToIntentHash": true
      }
    },
    {
      "id": "mcp-auth-tool-def-drift",
      "claim": "authority-enforcing",
      "setup": "tool schema hash differs from grant",
      "expect": {
        "action": "BLOCK",
        "executorCalled": false
      }
    }
  ]
}
